# ==============================================================================
# UniNova — Repository Git Ignore (.gitignore)
# ==============================================================================

# Environment files & secrets (Strict protection)
.env
.env.*
*.env
*.pem
*.key
!.env.example
!frontend/.env.example
!backend/.env.example

# Node.js / Next.js
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Python / FastAPI (anchored to prevent ignoring frontend/src/lib)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
backend/env/
backend/venv/
backend/lib/
backend/lib64/
develop-eggs/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Explicitly ensure frontend libraries and modules are always tracked
!frontend/src/lib/
!frontend/src/lib/**

# Testing, Linting & Coverage
.pytest_cache/
backend/.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
coverage.xml

# Databases & Persistent Local Storage
*.sqlite
*.sqlite3
*.db
backend/uploads/
mysql_data/

# Terraform Local State & Artifacts
.terraform/
*.tfstate
*.tfstate.*
*.tfvars.json
.terraform.lock.hcl

# OS and Editor artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
