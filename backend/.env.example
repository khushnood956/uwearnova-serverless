# ==============================================================================
# UniNova Backend Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env (or root .env) for backend configuration.
# ==============================================================================

# Application Environment (strict allowlist: development, test, staging, production)
APP_ENV=development
APP_NAME="UniNova API"
APP_VERSION=0.1.0
DEBUG=true
PORT=8000
HOST=0.0.0.0
API_V1_PREFIX=/api/v1

# Security Key (minimum 32 characters in staging/production)
SECRET_KEY=uninova-dev-insecure-secret-key-32-chars-minimum-needed

# CORS Allowlist (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=uninova_db
MYSQL_USER=uninova_user
MYSQL_PASSWORD=uninova_secure_password

# Database URLs (explicit or computed from MYSQL_* vars)
DATABASE_URL=mysql+pymysql://uninova_user:uninova_secure_password@localhost:3306/uninova_db
DATABASE_URL_ASYNC=mysql+aiomysql://uninova_user:uninova_secure_password@localhost:3306/uninova_db

# Store Policy Configuration (Pakistan Context)
STORE_CURRENCY=PKR
FREE_SHIPPING_THRESHOLD=5000
STANDARD_SHIPPING_FEE=350
COD_ENABLED=true

# Media & Storage Backend (mock | local | s3)
STORAGE_BACKEND=mock
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET_NAME=uninova-media

# Payment Gateway Provider (none | mock | safepay | payfast | jazzcash | easypaisa)
ONLINE_PAYMENT_PROVIDER=none
