# ==============================================================================
# UniNova E-Commerce — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env (or .env.local) and adjust values for your environment.
# Never commit actual production credentials or secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Application Settings
# ------------------------------------------------------------------------------
APP_ENV=development                  # development | staging | production | test
APP_NAME="UniNova API"
DEBUG=true
PORT=8000
HOST=0.0.0.0
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string-for-session-signing

# Allowed CORS origins (comma-separated list for frontend integration)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 2. MySQL Database Configuration
# ------------------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=uninova_db
MYSQL_USER=uninova_user
MYSQL_PASSWORD=uninova_secure_password
MYSQL_ROOT_PASSWORD=root_secure_password

# Standard SQLAlchemy connection strings
DATABASE_URL=mysql+pymysql://uninova_user:uninova_secure_password@localhost:3306/uninova_db
DATABASE_URL_ASYNC=mysql+aiomysql://uninova_user:uninova_secure_password@localhost:3306/uninova_db

# ------------------------------------------------------------------------------
# 3. Authentication, JWT & Session Security
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-another-secure-random-32-byte-hex-string-for-jwt
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
COOKIE_SECURE=false                  # Set to true in staging/production (requires HTTPS)
COOKIE_SAMESITE=lax                  # lax | strict | none
COOKIE_DOMAIN=localhost             # Adjust for staging/production domain

# ------------------------------------------------------------------------------
# 4. Media Storage / AWS S3 Configuration
# ------------------------------------------------------------------------------
STORAGE_BACKEND=mock                 # mock | local | s3
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET_NAME=uninova-media-staging
AWS_CLOUDFRONT_DOMAIN=media.uninova.example.com
MEDIA_UPLOAD_MAX_BYTES=10485760      # 10 MB maximum image size
PRESIGNED_URL_EXPIRE_SECONDS=900     # 15 minutes

# ------------------------------------------------------------------------------
# 5. Commerce & Store Policy Settings (Pakistan Context)
# ------------------------------------------------------------------------------
STORE_CURRENCY=PKR
FREE_SHIPPING_THRESHOLD=5000         # Free delivery threshold in PKR
STANDARD_SHIPPING_FEE=350            # Standard delivery fee below threshold in PKR
COD_ENABLED=true                     # Cash on Delivery enabled
MAX_CART_LINE_ITEMS=50

# ------------------------------------------------------------------------------
# 6. Storefront Next.js Client Variables
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_STORE_NAME=UniNova
NEXT_PUBLIC_STORE_CURRENCY=PKR

# ------------------------------------------------------------------------------
# 7. Online Payment Gateway Adapter Configuration (Pakistan Context)
# ------------------------------------------------------------------------------
# Do not assume provider availability without active merchant credentials.
# Default is "none" (store operates cleanly on first-class COD).
ONLINE_PAYMENT_PROVIDER=none         # none | mock | safepay | payfast | jazzcash | easypaisa
PAYMENT_WEBHOOK_SECRET=replace-with-gateway-webhook-signing-secret
PAYMENT_GATEWAY_API_KEY=replace-with-gateway-api-key
PAYMENT_GATEWAY_MERCHANT_ID=replace-with-merchant-account-id
PAYMENT_GATEWAY_BASE_URL=https://sandbox.api.gateway.example.com
